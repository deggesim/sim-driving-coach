{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "outDir": "out",
    "types": []
  },
  "include": [
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx",
    "src/shared/**/*.ts"
  ],
  // Self-checks are Node scripts (node:assert); they typecheck under
  // tsconfig.node.json / tsconfig.selfcheck.json, not with `types: []`.
  "exclude": ["src/**/*.selfcheck.ts"]
}

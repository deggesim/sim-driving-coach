  "narrative": {
    "northStar": "Il muretto box",
    "overview": "È la postazione dell'ingegnere di pista, non il cruscotto del pilota. Durante il giro parla solo la voce. Lo schermo si apre dopo, nei box, e deve far leggere in fretta numeri, giri e analisi senza decorazioni. Il sistema è scuro, piatto e utilitario: controlli Bootstrap ridipinti con le variabili di global.css, nessuna espressione per sé stessa.",
    "keyCharacteristics": [
      "Solo tema scuro: ogni componente nuovo usa le variabili :root.",
      "Densità da strumento: testo a 14px, etichette a 11px maiuscole.",
      "Superfici piatte a strati tonali, senza ombre.",
      "Un accento, tre colori di gioco, quattro colori di stato."
    ],
    "rules": [
      {
        "name": "The One Accent Rule",
        "body": "L'arancio marca ciò che è attivo o da leggere per primo. Non si usa per decorare riquadri né per ripetere uno stato.",
        "section": "colors"
      },
      {
        "name": "The Game Colour Rule",
        "body": "I colori R3E/ACE/AMS2 identificano la sorgente e compaiono soltanto in .game-badge--*.",
        "section": "colors"
      },
      {
        "name": "The Heading Ladder Rule",
        "body": "h2 e h3 dell'analisi sono arancio, h4 e oltre usano il colore del testo. Le due intestazioni radice sono le sole h2.",
        "section": "typography"
      },
      {
        "name": "The Flat Layers Rule",
        "body": "Un livello più in alto vuol dire un grigio più chiaro, non un'ombra. Per separare due superfici si usa un bordo da 1px.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do usare le variabili --bg, --bg2, --bg3, --border, --text, --text-dim, --accent per ogni colore di interfaccia.",
      "Do aggiungere l'override scuro in global.css per ogni componente Bootstrap nuovo.",
      "Do distinguere i livelli con un grigio più chiaro e un bordo da 1px.",
      "Do riservare l'arancio a ciò che è attivo, ai titoli di sezione dell'analisi e al punto di attenzione.",
      "Do mostrare sempre il dato numerico accanto alla sua etichetta."
    ],
    "donts": [
      "Don't usare componenti Bootstrap chiari senza override scuro.",
      "Don't aggiungere ombre per dare rilievo.",
      "Don't usare i colori R3E/ACE/AMS2 fuori dal badge del gioco.",
      "Don't introdurre un secondo colore enfatico accanto all'arancio.",
      "Don't nominare nella UI la procedura di messa a punto (scaletta, sequenza, passo N)."
    ]
  }

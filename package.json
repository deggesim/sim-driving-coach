{
  "name": "sim-driving-coach",
  "version": "0.3.0",
  "author": "Simone De Gennaro",
  "description": "Sim Racing Driving Coach — real-time driving coach for Sim racing games, supports RaceRoom Racing Experience (R3E), Assetto Corsa EVO (ACE) and Automobilista 2 (AMS2).",
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:electron": "electron-vite build && electron-builder",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "start": "electron-vite preview",
    "lint": "eslint .",
    "selfcheck": "tsc -p tsconfig.selfcheck.json && node scripts/run-selfchecks.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "rebuild:native": "npx @electron/rebuild -f -w better-sqlite3",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.0",
    "axios": "^1.15.0",
    "better-sqlite3": "^12.9.0",
    "bootstrap": "^5.3.8",
    "koffi": "^2.16.0",
    "marked": "^18.0.1",
    "react-bootstrap": "^2.10.10",
    "recharts": "^3.8.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^4.2.3",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^6.0.0-beta.1",
    "eslint": "^10.2.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "3.9.6",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.8"
  },
  "overrides": {
    "minimatch@>=10": {
      "brace-expansion": "^5.0.8"
    }
  }
}

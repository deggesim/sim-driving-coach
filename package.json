{
  "name": "sim-driving-coach",
  "version": "2.3.0",
  "private": true,
  "author": "Simone De Gennaro",
  "description": "Sim Racing Driving Coach — real-time driving coach for Sim racing games, supports RaceRoom Racing Experience (R3E), Assetto Corsa EVO (ACE) and Automobilista 2 (AMS2).",
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:debug": "node scripts/dev-debug.mjs",
    "build": "electron-vite build",
    "build:electron": "electron-vite build && electron-builder",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "start": "electron-vite preview",
    "lint": "eslint .",
    "update:ams2-cars": "node scripts/update-ams2-cars.mjs",
    "selfcheck": "node -e \"require('node:fs').rmSync('.selfcheck-out',{recursive:true,force:true})\" && tsc -p tsconfig.selfcheck.json && node scripts/run-selfchecks.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "rebuild:native": "npx @electron/rebuild -f -w better-sqlite3",
    "fallow": "fallow",
    "fallow:check": "fallow dead-code",
    "fallow:fix": "fallow fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.0",
    "axios": "^1.15.0",
    "better-sqlite3": "^12.9.0",
    "bootstrap": "^5.3.8",
    "electron-updater": "^6.8.11",
    "i18next": "^27.1.1",
    "koffi": "^2.16.0",
    "marked": "^18.0.1",
    "react-bootstrap": "^2.10.10",
    "react-i18next": "^18.0.1",
    "recharts": "^3.8.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@eslint-react/eslint-plugin": "^4.2.3",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^6.0.0-beta.1",
    "eslint": "^10.2.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fallow": "^3.27.0",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "3.9.6",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "semantic-release": "^25.0.9",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.8"
  },
  "overrides": {
    "minimatch@>=10": {
      "brace-expansion": "^5.0.8"
    }
  }
}
